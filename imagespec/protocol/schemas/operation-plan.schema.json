{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameassetforge.local/imagespec/operation-plan.schema.json",
  "title": "ImageSpec OperationPlan 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "planId",
    "projectId",
    "baseRevision",
    "sourceUserRequest",
    "createdAt",
    "operations",
    "affectedAssets",
    "constraints",
    "ambiguities",
    "preview",
    "requiredApproval",
    "expectedOutputs",
    "status"
  ],
  "properties": {
    "$schema": { "const": "https://gameassetforge.local/imagespec/operation-plan.schema.json" },
    "schemaVersion": { "const": "2.0" },
    "planId": { "$ref": "common.schema.json#/$defs/stableId" },
    "projectId": { "$ref": "common.schema.json#/$defs/stableId" },
    "baseRevision": { "$ref": "common.schema.json#/$defs/revision" },
    "sourceUserRequest": { "type": "string" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "affectedAssets": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/stableId" },
      "uniqueItems": true
    },
    "constraints": { "$ref": "#/$defs/constraints" },
    "ambiguities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ambiguity" }
    },
    "preview": { "$ref": "#/$defs/preview" },
    "requiredApproval": { "type": "boolean" },
    "expectedOutputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/expectedOutput" }
    },
    "status": {
      "enum": ["draft", "planned", "needs_confirmation", "approved", "executing", "applied", "validated", "rejected", "ambiguous", "blocked", "failed", "stale"]
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "op", "params", "allowedChanges", "deniedChanges", "requiresApproval"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/stableId" },
        "op": {
          "enum": ["asset.import", "asset.rename", "asset.move", "asset.align", "asset.resize", "asset.setPolicy", "asset.process", "asset.replaceSource", "asset.generate", "asset.reconstruct", "asset.delete", "region.create", "region.associate", "region.update", "region.setMasks", "region.delete", "exportPreset.update", "project.validate", "project.build", "project.export"]
        },
        "targetId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "params": { "type": "object" },
        "allowedChanges": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "deniedChanges": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requiresApproval": { "type": "boolean" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvasSizeUnchanged", "protectedAssetHashUnchanged"],
      "properties": {
        "canvasSizeUnchanged": { "type": "boolean" },
        "protectedAssetHashUnchanged": { "type": "boolean" },
        "outsideChangedPixels": { "type": "integer", "minimum": 0 },
        "allowedRegionIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/stableId" }, "uniqueItems": true },
        "maxChangedPixels": { "type": "integer", "minimum": 0 },
        "mustPreserveAssetIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "candidates"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/stableId" } }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "changes", "warnings"],
      "properties": {
        "summary": { "type": "string" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationId", "description"],
            "properties": {
              "operationId": { "$ref": "common.schema.json#/$defs/stableId" },
              "assetId": { "$ref": "common.schema.json#/$defs/stableId" },
              "description": { "type": "string" },
              "before": {},
              "after": {}
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "previewFiles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativePath" } }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "assetId": { "$ref": "common.schema.json#/$defs/stableId" }
      }
    }
  }
}
